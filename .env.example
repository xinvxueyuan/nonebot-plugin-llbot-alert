# =============================================================================
# llbot-alert — Environment Configuration Example
# =============================================================================
# 复制为 .env.dev（部署到 zhenxun 时追加进其 .env.dev）并按需填写。
# 配置项由 src/plugins/nonebot_plugin_llbot_alert/config.py::Config 解析，
# 环境变量名与字段名大小写不敏感。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 总开关与文案
# -----------------------------------------------------------------------------

# 是否启用告警（false 时既不处理心跳，也不监听连接事件）。
LLBOT_ALERT_ENABLED=true

# 邮件文案中的服务名。
LLBOT_ALERT_SERVICE_NAME=LLBot

# 需要监控的账号 QQ 号集合（JSON 数组）；空数组表示监控全部。
LLBOT_ALERT_ACCOUNTS=[]


# -----------------------------------------------------------------------------
# 2. 账号状态来源：OneBot 心跳事件（meta_event/heartbeat）
# -----------------------------------------------------------------------------
# 心跳结构：{"post_type":"meta_event","meta_event_type":"heartbeat",
#            "status":{"online":true,"good":true},"interval":6000,...}
# status.online / status.good 即账号状态，随心跳持续到达，无需轮询 HTTP 接口。

# 心跳静默超时（秒）：超过该时长未收到任何心跳即判定为服务异常
# （连接假死或事件通道阻塞）；设为 0 表示不检测静默。
LLBOT_ALERT_HEARTBEAT_TIMEOUT=60

# 心跳静默检查的间隔（秒，下限 5）。
LLBOT_ALERT_CHECK_INTERVAL=15


# -----------------------------------------------------------------------------
# 3. 告警邮件
# -----------------------------------------------------------------------------

# 收件人集合（JSON 数组）。
LLBOT_ALERT_TO=["xinvxueyuan@yeah.net"]

# 同类告警的最小重发间隔（秒）：持续异常超过该间隔会重发提醒；
# 设为 0 表示只在状态变化（异常/恢复）时发送。
LLBOT_ALERT_COOLDOWN=600

# 状态恢复时是否补发恢复通知。
LLBOT_ALERT_NOTIFY_RECOVERY=true

# SMTP 服务器（用法：smtplib.SMTP_SSL(host, port) -> login(user, pass)）。
# 连接/发送超时（秒）：超时即放弃本次发送，避免拖住进程退出。
LLBOT_ALERT_SMTP_TIMEOUT=10
LLBOT_ALERT_SMTP_HOST=
LLBOT_ALERT_SMTP_PORT=465
LLBOT_ALERT_SMTP_SSL=true
LLBOT_ALERT_SMTP_USER=
LLBOT_ALERT_SMTP_PASS=

# 发件人（须为受 SPF 授权的域名地址）。
LLBOT_ALERT_MAIL_FROM=
LLBOT_ALERT_MAIL_FROM_NAME=LLBot Alert
